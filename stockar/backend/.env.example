# Copiá este archivo a .env y ajustá los valores.

# Puerto del backend
PORT=3000

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Orígenes que pueden llamar a la API desde el navegador (separados por coma).
# En desarrollo el frontend usa el proxy de Vite, así que esto aplica a llamadas directas.
CORS_ORIGINS=http://stockar,http://stockar:5173,http://localhost:5173
