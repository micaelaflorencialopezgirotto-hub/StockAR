# Configuración del frontend en producción (npm run build / npm run preview).

# Base de la API para el navegador.
# Vacío = mismo origen (/api): el servidor que publica el frontend reenvía /api al backend.
# Si la API está en otro dominio, poné su URL completa, por ejemplo: VITE_API_URL=https://api.stockar.com.ar
# (y agregá el dominio del frontend a CORS_ORIGINS en el backend).
VITE_API_URL=
