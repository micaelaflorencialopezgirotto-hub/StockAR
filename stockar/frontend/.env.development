# Configuración del frontend en desarrollo (npm run dev).
# Para cambiar algo solo en tu máquina, copiá la variable a .env.local (no se versiona).

# Dominio con el que se abre la app: http://stockar (ver stockar/docs/acceso-stockar.md).
STOCKAR_HOST=stockar

# Puerto del servidor de Vite (dev y preview). El puerto 80 se redirige a este con pf.
STOCKAR_PORT=5173

# Backend al que Vite reenvía las peticiones a /api (solo en desarrollo, del lado del servidor).
STOCKAR_API_PROXY=http://localhost:3000

# Base de la API para el navegador. Vacío = mismo origen (/api), que pasa por el proxy de Vite.
VITE_API_URL=
